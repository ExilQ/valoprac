{
  "name": "valoprac",
  "version": "12.0.22",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc -b && node scripts/package-unreal.mjs && vite build && node --test scripts/interface-palette.test.mjs && node scripts/verify-interface-palette.mjs && node scripts/export-routes.mjs && node scripts/verify-build.mjs && node scripts/verify-modern-web.mjs && node scripts/verify-search.mjs && node scripts/build-response-worker.mjs && node scripts/verify-response-worker.mjs",
    "test": "vitest run --reporter=verbose",
    "typecheck": "tsc -b",
    "prebuild": "node scripts/sync-interface-tokens.mjs && node scripts/validate-release.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "test:broker": "node --test infrastructure/pixel-streaming/*.test.mjs",
    "test:core": "node scripts/test-unreal-core.mjs",
    "export:unreal": "node scripts/export-unreal-data.mjs",
    "package:unreal": "node scripts/package-unreal.mjs",
    "verify:migration": "node scripts/verify-migration.mjs",
    "test:hosting": "node --test worker/*.test.mjs",
    "verify:search": "node scripts/verify-search.mjs",
    "build:cloudflare": "tsc -b && node scripts/package-unreal.mjs && vite build && node scripts/export-routes.mjs"
  },
  "dependencies": {
    "@epicgames-ps/lib-pixelstreamingfrontend-ue5.7": "0.3.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^6.4.0",
    "vitest": "^3.2.4",
    "wrangler": "4.168.0"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}

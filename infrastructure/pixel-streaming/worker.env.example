VALOPRAC_SITE_ORIGIN=https://valoprac.trade
VALOPRAC_GPU_ORIGIN=https://gpu-staging.valoprac.trade
VALOPRAC_GPU_HOST=gpu-staging.valoprac.trade
VALOPRAC_ENGINE_LAUNCHER=/opt/valoprac/builds/ue57/Linux/VALOPRAC.sh
VALOPRAC_INFRA_ROOT=/opt/valoprac/epic-pixel-streaming
VALOPRAC_READY_CHECK=/opt/valoprac/infrastructure/pixel-streaming/verify-ready.mjs
VALOPRAC_CAPACITY=1
# Set real ICE URLs and ephemeral TURN credentials in the protected env file.
# Do not ship permanent credentials to the website or source repository.
# VALOPRAC_PEER_OPTIONS={"iceServers":[...]}

# REQUIRED before running the optional GPU broker. Use a random secret with at
# least 32 random bytes, configured privately here AND in Sites runtime secrets.
# Never place its value in this example, Git, a VITE_ variable, or browser config.
# VALOPRAC_GPU_GRANT_SECRET=<private shared secret>
# In Sites runtime also configure VALOPRAC_GPU_ORIGIN and the comma-separated
# VALOPRAC_GPU_ALLOWED_USERS native Sites user IDs. An empty allowlist denies all.
